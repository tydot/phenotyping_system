# =============================================================
# ARM 功能表型系统 - Jetson Orin Nano Super 环境变量
# 部署时复制为 .env：cp .env.jetson .env
# =============================================================

# === PyTorch CUDA 内存管理 ===
# 减少显存碎片，对 8GB 统一内存的 Jetson 尤为重要
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:256

# === Neo4j 连接 ===
# Docker 内部通信使用 neo4j 主机名，外部访问使用 localhost
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASS=12345678

# === LLM 配置 ===
# rule = 规则版报告（默认，无需 API）
# xiaomi = 小米 MiMo API（需配置 API Key）
LLM_ENABLE_REAL_API=false
LLM_PROVIDER=rule

# === 小米 MiMo API（可选，用于 LLM 报告生成） ===
# 取消注释并填写 API Key 以启用真实 LLM 报告
# XIAOMI_API_KEY=your_api_key_here
# XIAOMI_BASE_URL=https://api.xiaomimimo.com/v1
# XIAOMI_MODEL=mimo-v2.5

# === 腾讯云 COS（可选，用于从云端加载原始 ARM 图像） ===
# 取消注释并填写凭证以启用 COS 图片下载
# COS_SECRET_ID=your_cos_secret_id
# COS_SECRET_KEY=your_cos_secret_key
# COS_REGION=ap-guangzhou
# COS_BUCKET=your-bucket-name
